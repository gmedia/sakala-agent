# Copy to .env for local development: cp .env.example .env && php artisan key:generate
# On Sakala, set these in the project's Variabel tab instead. A database
# attached on the Database page sets DATABASE_URL and DB_* by itself.
# The .env file is never deployed.

APP_NAME="Buku tamu Sakala"
APP_ENV=local
# Required. Generate one with: php artisan key:generate --show
# On Sakala, save it as a secret. Never commit a real key.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database. Leave all of these empty and the app still starts: it shows how to
# connect a database, and `php artisan migrate --force` runs against a throwaway
# in-memory SQLite database. Set DATABASE_URL (or DB_URL, or DB_HOST and the
# rest) to use PostgreSQL. On Sakala you do not set these: attach a database
# from the Database page and redeploy.
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=guestbook
# DB_USERNAME=postgres
# DB_PASSWORD=
# For a local SQLite file instead: DB_CONNECTION=sqlite, then touch database/database.sqlite
# DB_CONNECTION=sqlite

# Sessions live in an encrypted cookie, so the app needs no database or disk for
# them and keeps working across redeploys.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync
