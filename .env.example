SAKALA_AGENT_MODE=local
SAKALA_AGENT_ID=local-agent-01
SAKALA_AGENT_TOKEN=change-me
SAKALA_API_URL=http://localhost:8000
SAKALA_POLL_INTERVAL_SECONDS=3
SAKALA_HEARTBEAT_INTERVAL_SECONDS=10
SAKALA_RUNTIME_NETWORK=sakala-runtime
SAKALA_RUNTIME_DRIVER=noop
SAKALA_RUNTIME_WORKSPACE=/var/lib/sakala/builds
SAKALA_CADDY_SITES_DIR=/var/lib/sakala/caddy/sites
SAKALA_CADDY_CONTAINER=sakala-caddy
SAKALA_RAILPACK_FRONTEND=ghcr.io/railwayapp/railpack-frontend:v0.23.0
SAKALA_DEFAULT_CONTAINER_MEMORY_MB=256
SAKALA_MAX_CONTAINER_MEMORY_MB=512
SAKALA_DEFAULT_CONTAINER_CPU_MILLIS=500
SAKALA_MAX_CONTAINER_CPU_MILLIS=1000
SAKALA_DEFAULT_CONTAINER_PIDS_LIMIT=128
SAKALA_MAX_CONTAINER_PIDS_LIMIT=256
SAKALA_LOG_LEVEL=info
